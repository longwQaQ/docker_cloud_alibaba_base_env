# 使用 scripts/init-env.sh 生成真实的 .env，不要提交 .env。
BIND_ADDRESS=127.0.0.1
MYSQL_PORT=3306
NACOS_HTTP_PORT=8848
NACOS_GRPC_PORT=9848
SENTINEL_PORT=8858
SEATA_PORT=8091
MYSQL_ROOT_PASSWORD=请替换为随机强密码
MYSQL_APP_PASSWORD=请替换为随机强密码
NACOS_AUTH_TOKEN=请替换为至少32字节原始内容的Base64字符串
NACOS_AUTH_IDENTITY_KEY=请替换为随机标识键
NACOS_AUTH_IDENTITY_VALUE=请替换为随机标识值
NACOS_ADMIN_PASSWORD=请替换为随机强密码
SENTINEL_USERNAME=sentinel
SENTINEL_PASSWORD=请替换为随机强密码
